# Pulls the Stryd plan and writes plan.json next to the app.
#
#   install -m644 deploy/postrun-stryd-sync.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now postrun-stryd-sync.timer
#
# Runs as www-data: it needs to write one file into the web root and read one
# token, and nothing else on this machine.
[Unit]
Description=Sync the Stryd training plan into postrun's plan.json
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/postrun-sync
ExecStart=/usr/bin/python3 -m tools.stryd.sync --verify

# pid 1 reads the token as root, before dropping to www-data, and leaves it on a
# ramfs only this unit can read. So the token stays root:root 0600 and www-data
# never gets access to the file itself -- which matters, because nginx runs as
# www-data too. Nothing lands in the environment, and it is unmounted on exit.
LoadCredential=stryd:/etc/postrun/stryd.token

# A sync job has no business anywhere but its own directory and the web root.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/www/postrun.zuacaldeira.com
