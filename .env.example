# cp .env.example .env  and edit
APP_DOMAIN=postrun.zuacaldeira.com

# :latest only ever moves from the default branch. Until this work is merged,
# pin the branch tag to try it out:
#   IMAGE_TAG=claude-video-full-width-card-aueowt
IMAGE_TAG=latest

# --- hourly training sync (compose.sync.yaml) -------------------------------
# From intervals.icu → Settings → Developer. The athlete id is the iNNNNN in
# your profile URL. Only needed if you run the sync overlay.
INTERVALS_ATHLETE_ID=i000000
INTERVALS_API_KEY=
SYNC_INTERVAL=3600
